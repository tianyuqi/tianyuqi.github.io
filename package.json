{
  "name": "tianyuqi-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config projects/hex-pairs/vite.config.ts --host 0.0.0.0",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build --config projects/hex-pairs/vite.config.ts && vite build --config projects/estimathon/vite.config.ts && vite build --config projects/homebuyer/vite.config.ts && vite build --config projects/number-hunt/vite.config.ts && node scripts/build-site.mjs",
    "preview": "vite preview --config projects/hex-pairs/vite.config.ts --host 0.0.0.0",
    "dev:estimathon": "vite --config projects/estimathon/vite.config.ts --host 0.0.0.0",
    "dev:homebuyer": "vite --config projects/homebuyer/vite.config.ts --host 0.0.0.0",
    "data:homebuyer": "node scripts/homebuyer/import.mjs",
    "test:homebuyer-data": "node --test scripts/homebuyer/normalize.test.mjs",
    "dev:number-hunt": "vite --config projects/number-hunt/vite.config.ts --host 0.0.0.0"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
